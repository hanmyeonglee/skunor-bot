    "@openai/codex-sdk": "0.160.0",
    "better-sqlite3": "13.0.3",
    "cron-parser": "5.10.1",
    "discord.js": "14.27.0",
    "notion-client": "8.0.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "24.19.1",
    "typescript": "6.0.3"
  }
}
